PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_IN_MINUTES=60
DEFAULT_USER_ROLE_ID=1
DEFAULT_BOUTIQUE_ID=1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id

# URL du frontend, utilisee pour construire le lien de reinitialisation dans l'email
APP_URL=http://localhost:5173

# Envoi d'emails (SMTP). Si SMTP_HOST est vide, les emails sont affiches dans les
# logs du serveur (mode developpement) au lieu d'etre envoyes.
# Exemple avec Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Tip Top <no-reply@thetiptop.fr>
